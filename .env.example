OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_HTTP_REFERER=https://github.com/bielfelix/smart-model-router-gateway
OPENROUTER_APP_TITLE=Smart Model Router Gateway

PORT=3000
ROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,inclusionai/ling-3.0-flash:free,openai/gpt-oss-20b:free
ROUTER_STRATEGY=throughput
ROUTER_MAX_TOKENS=256
ROUTER_MAX_PROMPT_CHARS=8000
ROUTER_TEMPERATURE=0.2
ROUTER_PROVIDER_PARTITION=none
ROUTER_SYSTEM_PROMPT=You are a helpful assistant.
